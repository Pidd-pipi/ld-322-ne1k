# Compose 项目名（小写字母/数字/-/_），避免中文目录名导致 project name 为空
COMPOSE_PROJECT_NAME=cygreenenv

DB_NAME=greenhouse
DB_USER=greenhouse
DB_PASSWORD=greenhouse_pwd
DB_ROOT_PASSWORD=root_pwd

# JWT 签名密钥，生产环境必须替换为足够长的随机字符串
JWT_SECRET=change_me_to_a_long_random_string

FRONTEND_PORT=18622
BACKEND_PORT=19622
DB_PORT=33062

# 定时任务执行器使用的时区（设备定时按此时区的每天固定时刻触发）
TZ=Asia/Shanghai
